# Environment variables for VendorLens
# Copy this to .env and fill in values as needed

# ─── Database ────────────────────────────────────────
# SQLite file path (relative to project root)
DATABASE_URL="file:./vendorlens.db"

# ─── Optional API Keys (app works fully without these) ──
# HaveIBeenPwned API key — enables breach history checks
# HIBP_API_KEY=

# Shodan API key — enables exposed-service scans
# SHODAN_API_KEY=

# AI Summary (pick one; if neither is set, a deterministic template is used)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ─── Rate Limiting ───────────────────────────────────
# Max scan requests per minute per IP (default 10)
SCAN_RATE_LIMIT=10
